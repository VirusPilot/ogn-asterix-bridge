[Unit]
Description=OGN APRS to readsb ASTERIX bridge
After=network-online.target readsb.service
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/python3 /home/pi/ogn-asterix-bridge/bridge.py --callsign @CALLSIGN@ --lat @LAT@ --lon @LON@ --radius-km 50
Restart=always
RestartSec=10
StateDirectory=ogn-asterix-bridge
StateDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
